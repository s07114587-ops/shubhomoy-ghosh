<!DOCTYPE html>
<html lang="bn">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>😀Shubhomoy😃</title>
    <style>
        /* পুরো পেজের গ্লোবাল স্টাইল */
        body {
            background-image: url('1.png');
            background-repeat: no-repeat;
            background-size: cover;
            background-attachment: fixed;
            background-position: center;
            margin: 0;
            padding: 20px;
            color: white;
            font-family: 'Arial', sans-serif;
            text-align: center;
        }

        /* হেডিং-এর জন্য তোর সেই খতরনাক অ্যানিমেশন */
        @keyframes hackerWobble {
            0% { transform: rotate(-2deg); }
            100% { transform: scale(1.05) rotate(2deg); }
        }

        .hacker-title {
            font-family: 'Algerian', sans-serif;
            font-size: clamp(24px, 5vw, 48px); /* মোবাইল এবং পিসি সব স্ক্রিনে অটো সাইজ হবে */
            color: #8B4513; /* Brown */
            margin-top: 20px;
        }

        .wobble-text {
            display: inline-block;
            animation: hackerWobble 2s ease-in-out infinite alternate;
            text-decoration: underline;
            font-style: italic;
            font-weight: bold;
        }

        /* লিংকগুলোর স্টাইলিশ বাটন কন্টেইনার */
        .link-container {
            margin: 20px 0;
            background: rgba(0, 0, 0, 0.6); /* হালকা কালো স্বচ্ছ ব্যাকগ্রাউন্ড */
            padding: 15px;
            border-radius: 10px;
            display: inline-block;
        }

        .link-container a {
            color: yellow;
            text-decoration: none;
            font-size: 18px;
            font-weight: bold;
            margin: 0 15px;
            transition: 0.3s;
        }

        .link-container a:hover {
            color: #00ffcc;
            text-shadow: 0 0 10px #00ffcc;
        }

        /* ইমেজ ৩.jpg এবং ৩.png-এর নিয়ন গ্লো এফেক্ট */
        .neon-img {
            width: 90%;
            max-width: 300px;
            height: auto;
            border: 4px solid white;
            border-radius: 15px;
            box-shadow: 0 0 15px cyan, 0 0 30px dodgerblue, 0 0 45px blue;
            margin-top: 20px;
        }

        /* ক্রিকবাজ লাইভ স্কোর ইমেজের স্টাইল */
        .live-score {
            width: 120px;
            margin-top: 30px;
            border-radius: 8px;
            transition: 0.3s;
        }

        .live-score:hover {
            transform: scale(1.1);
            box-shadow: 0 0 15px orange;
        }
    </style>
</head>
<body>

    <marquee style="color: white; font-size: 24px; font-weight: bold; background: rgba(255,255,255,0.1); padding: 5px; border-radius: 5px;">
        Welcome to Shubhomoy's Page! 🚀 Keep Learning HTML!
    </marquee>

    <div class="hacker-title">
        <span class="wobble-text">😎 MY NAME IS SHUBHOMOY 😎</span>
    </div>

    <div>
        <div class="link-container">
            <a href="https://youtu.be/E7tCnT5LFLA?si=_8zo53Kc7KXo7hbk" target="_blank">📺 Video</a>
            <a href="https://i.pinimg.com/originals/c5/62/66/c56266dc0b47a35cb31e2a32622cedd5.gif" target="_blank">🖼️ Photo</a>
            <a href="https://poki.com/?utm_source=web_app_manifest" target="_blank">🏹 Play Games</a>
        </div>
    </div>

    <div>
        <img src="3.jpg" alt="Profile Picture" class="neon-img">
    </div>

    <div style="margin-top: 40px;">
        <a href="https://www.cricbuzz.com" target="_blank">
            <img src="4.jpg" alt="Live Score" class="live-score" title="Click to view clear live scorecard!">
        </a>
        <p style="font-size: 14px; color: orange; margin-top: 5px;">🏏 Click image for Live Scorecard!</p>
    </div>

</body>
</html>